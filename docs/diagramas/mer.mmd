title: "StockControl — Modelo Entidade-Relacionamento (MER)"
---
erDiagram
    USUARIO ||--o{ MOVIMENTACAO : "registra"
    USUARIO ||--o{ COMENTARIO : "escreve"
    PRODUTO ||--o{ MOVIMENTACAO : "possui"
    PRODUTO ||--o{ COMENTARIO : "recebe"

    USUARIO {
        identificador id
        texto nome
        texto perfil "admin ou user"
    }
    PRODUTO {
        identificador id
        texto codigo
        texto nome
        texto descricao
        inteiro quantidade
        decimal preco
        booleano status "ativo ou inativo"
        texto imagem
        data data_inclusao
    }
    MOVIMENTACAO {
        identificador id
        texto tipo "Entrada, Saida ou Ajuste"
        inteiro quantidade
        texto observacao
        data data_movimentacao
        inteiro saldo_apos
    }
    COMENTARIO {
        identificador id
        texto texto
        data data
    }
